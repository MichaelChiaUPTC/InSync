# Copia este archivo como back/.env en cada maquina y rellena los valores de ESA maquina.
# back/.env esta en .gitignore: no se sube a git. Serverless lo carga solo (deploy y wsgi serve).

# Dominio publico de Keycloak (ngrok), con https:// y sin barra final
KEYCLOAK_URL=https://TU-DOMINIO.ngrok-free.dev

# Client secret del cliente Beta0 en cada realm (Keycloak > realm > Clients > Beta0 > Credentials)
KEYCLOAK_CLIENT_SECRET_A=
KEYCLOAK_CLIENT_SECRET_B=

# Opcionales
# KEYCLOAK_CLIENT_ID=Beta0
# KEYCLOAK_REALM_A=tenantA
# KEYCLOAK_REALM_B=tenantB
# URL publica (ngrok) del Kafka REST Proxy; vacio = Kafka desactivado
# KAFKA_REST_URL=https://DOMINIO-KAFKA.ngrok-free.dev
